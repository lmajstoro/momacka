# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Local camera dump (app serves public/photos). Do not delete locally.
/slike/

# Large local videos — GitHub rejects files over 100MB; Vercel Hobby
# cannot host tens-of-MB clips well. Keep them on disk; host remotely later.
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.m4v

# typescript
*.tsbuildinfo
next-env.d.ts
